{
  "schemaVersion": 1,
  "id": "correctchat",
  "version": "${version}",
  "name": "Correct Chat",
  "description": "Client-side chat workspace with tabs, filters, logs, automation, alerts and Twitch integration.",
  "icon": "assets/correctchat/icon.png",
  "authors": ["dho"],
  "contributors": ["kadse", "HDSkins", "JumpingPxl", "Fesa"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["de.dho.correctchat.CorrectChatClient"],
    "modmenu": ["de.dho.correctchat.compat.CorrectChatModMenu"]
  },
  "mixins": [
    "${mixin_config}"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_dependency}",
    "fabric-api": ">=${fabric_api_dependency}"
  },
  "suggests": {
    "modmenu": "${modmenu_dependency}"
  }
}
